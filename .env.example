# Copy to .env (cp .env.example .env). Every value has a working default in docker-compose.yml.

# --- Database ---------------------------------------------------------------
POSTGRES_USER=flightlog
POSTGRES_PASSWORD=flightlog
POSTGRES_DB=flightlog
# Host port for Postgres (5434 avoids clashing with a locally installed Postgres).
DB_PORT=5434
# Used when running the API / tests on the host. Inside Docker the api service talks to "db:5432".
DATABASE_URL=postgresql://flightlog:flightlog@localhost:5434/flightlog
TEST_DATABASE_URL=postgresql://flightlog:flightlog@localhost:5434/flightlog_test

# --- API --------------------------------------------------------------------
# Host port the API is published on (inside Docker it always listens on 3000).
API_PORT=3001
MAX_UPLOAD_MB=10
# Minutes an import preview is kept server-side before it must be re-uploaded.
IMPORT_PREVIEW_TTL_MINUTES=30
# The seeded user. With AUTH_REQUIRED off (below) every request acts as this user; with it on it is
# just a normal account that owns the pre-auth flights (see "Authentication" in the README).
DEFAULT_USER_ID=00000000-0000-4000-8000-000000000001

# --- Authentication ---------------------------------------------------------
# Off (default): no login, every request acts as DEFAULT_USER_ID. On: email + password login with
# database sessions; create accounts with `npm run user:create -w @flight-log/api -- ...`.
AUTH_REQUIRED=false
# Session length; refreshed (at most hourly) while you keep using the app.
SESSION_TTL_DAYS=30
# Optional overrides. Defaults: COOKIE_SECURE=true and TRUST_PROXY_HOPS=1 when NODE_ENV=production
# (HTTPS behind Traefik), false / 0 otherwise. Set COOKIE_SECURE=false to test a production build
# over plain http.
# COOKIE_SECURE=
# TRUST_PROXY_HOPS=

# --- Web --------------------------------------------------------------------
WEB_PORT=5173
# Any MapLibre style JSON. The default needs no API key (OpenFreeMap, OSM data).
MAP_STYLE_URL=https://tiles.openfreemap.org/styles/liberty

# --- API docs ---------------------------------------------------------------
# Swagger UI at /api/docs and the spec at /api/openapi.json. On by default; set to
# "false" to disable (e.g. on a public deployment).
ENABLE_API_DOCS=true

# --- Flight lookup (Phase 2) ------------------------------------------------
# Empty = disabled (POST /api/lookup returns 501). "stub" = canned demo data.
FLIGHT_API_PROVIDER=
# How long cached provider responses are reused.
LOOKUP_CACHE_TTL_HOURS=720
# Placeholders for future providers (see docs/flight-data-api-analysis.md).
AERODATABOX_RAPIDAPI_KEY=
AVIATIONSTACK_API_KEY=
AIRLABS_API_KEY=
FLIGHTAWARE_AEROAPI_KEY=
