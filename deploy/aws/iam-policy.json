{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "Lightsail",
      "Effect": "Allow",
      "Action": "lightsail:*",
      "Resource": "*"
    },
    {
      "Sid": "DnsRecordsForTheAppZone",
      "Effect": "Allow",
      "Action": ["route53:ChangeResourceRecordSets", "route53:ListResourceRecordSets"],
      "Resource": "arn:aws:route53:::hostedzone/REPLACE_WITH_ZONE_ID"
    },
    {
      "Sid": "DnsLookups",
      "Effect": "Allow",
      "Action": ["route53:ListHostedZonesByName", "route53:GetChange"],
      "Resource": "*"
    }
  ]
}
