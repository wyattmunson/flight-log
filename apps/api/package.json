{
  "name": "@flight-log/api",
  "version": "0.1.0",
  "license": "PolyForm-Noncommercial-1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch --clear-screen=false src/index.ts",
    "start": "tsx src/index.ts",
    "test": "vitest run",
    "test:unit": "vitest run test/unit",
    "typecheck": "tsc -p tsconfig.json",
    "db:migrate": "node scripts/prisma.mjs migrate deploy",
    "db:generate": "node scripts/prisma.mjs generate",
    "seed:reference": "tsx src/seed/cli.ts",
    "seed:reference:if-empty": "tsx src/seed/cli.ts --if-empty",
    "seed:aircraft-families": "tsx src/seed/aircraftFamilies.ts",
    "prisma": "node scripts/prisma.mjs"
  },
  "prisma": {
    "schema": "prisma/schema.prisma"
  },
  "dependencies": {
    "@flight-log/shared": "*",
    "@prisma/client": "^6.19.0",
    "csv-parse": "^7.0.3",
    "express": "^4.21.2",
    "luxon": "^3.5.0",
    "multer": "^2.0.0",
    "prisma": "^6.19.0",
    "swagger-ui-express": "^5.0.1",
    "tsx": "^4.19.2",
    "tz-lookup": "^6.1.25",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/luxon": "^3.4.2",
    "@types/multer": "^1.4.12",
    "@types/node": "^22.10.2",
    "@types/supertest": "^6.0.2",
    "@types/swagger-ui-express": "^4.1.8",
    "supertest": "^7.0.0",
    "vitest": "^2.1.8"
  }
}
